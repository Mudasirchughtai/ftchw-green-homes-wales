# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Privyr CRM (server-side only) --- see docs/PRIVYR_SETUP.md
PRIVYR_WEBHOOK_URL=

# --- Site URL / canonical / indexing --- see docs/DEPLOYMENT_CHECKLIST.md
# The approved production domain, e.g. https://firsttimecentralheatingwales.com
NEXT_PUBLIC_SITE_URL=

# --- Google Analytics 4 / Ads / Meta / Clarity --- see docs/ANALYTICS_SETUP.md
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Anti-spam / bot protection --- see docs/DEPLOYMENT_CHECKLIST.md
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Funding scheme config ---
# Date the enhanced £9,000 grant wording becomes active (ISO 8601)
ENHANCED_GRANT_ACTIVE_DATE=2026-07-21

# --- Legal / company details (for footer disclaimer) ---
# Do NOT invent these -- footer shows a loud dev warning and a real
# production deploy is blocked until they're set. See config/company.ts.
LEGAL_ENTITY_NAME=
COMPANY_NUMBER=
REGISTERED_ADDRESS=
ICO_REGISTRATION_NUMBER=
